#!/ usr / bin / env lua
-- -chrono — benchmark runner executable.-- -Installed by LuaRocks into the system bin directory.-- -Supports both LuaRocks installs and local repository execution.

    do local script = arg and arg[0] or "chrono" local dir = script : match "^(.+)[/\\]" or "." local root = dir if dir == "bin" or dir == ".\\bin" or dir == "./bin" then root = "." else root = dir : gsub("([/\\])bin$", "")
                                                                                                                                                                                                            end
                                                                                                                                                                                                                package.path = root.."/lua/?.lua;"..root.."/lua/?/init.lua;"..package.path
                                                                                                                                                                                                                                   package.cpath = root.."/c/?.so;"..root.."/c/?.dll;"..package.cpath
                                                                                                                                                                                                                                                       end

                                                                                                                                                                                                                                                           require("chrono.cli")
                                                                                                                                                                                                                                                               .main(arg)